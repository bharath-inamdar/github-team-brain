# -----------------------------
# Application
# -----------------------------
APP_NAME=GitHub Team Brain API
APP_VERSION=1.0.0
DEBUG=True

# -----------------------------
# Authentication (JWT)
# -----------------------------
# Use a long random secret, for example: openssl rand -hex 32
JWT_SECRET=your_long_random_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------
# Bootstrap admin
# -----------------------------
# Existing repositories are assigned to this account by the
# 0003_repository_user_id migration. Set a strong password so the
# account can be used after the migration; the password is never
# stored in source code or migrations.
BOOTSTRAP_ADMIN_EMAIL=admin@teambrain.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=your_strong_admin_password

# -----------------------------
# GitHub
# -----------------------------
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REQUEST_TIMEOUT_SECONDS=15

# -----------------------------
# Google Gemini
# -----------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# -----------------------------
# PostgreSQL
# -----------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/github_team_brain

# -----------------------------
# ChromaDB
# -----------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=teambrain

# -----------------------------
# Frontend
# -----------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
